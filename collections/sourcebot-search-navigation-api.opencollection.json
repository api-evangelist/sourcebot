{
  "opencollection": "1.0.0",
  "info": {
    "name": "Sourcebot Public Enterprise (EE) Enterprise (EE) Search & Navigation API",
    "version": "v5.1.3"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Search & Navigation",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Search code",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/search",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Executes a blocking code search and returns all matching file chunks."
        },
        {
          "info": {
            "name": "Find symbol definitions",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/find_definitions",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Returns all locations in the codebase where the given symbol is defined."
        },
        {
          "info": {
            "name": "Find symbol references",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/api/find_references",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Returns all locations in the codebase where the given symbol is referenced."
        }
      ]
    }
  ],
  "bundled": true
}